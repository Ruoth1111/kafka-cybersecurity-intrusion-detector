# ─────────────────────────────────────────────
# Kafka Configuration
# ─────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=network_traffic

# ─────────────────────────────────────────────
# PostgreSQL Configuration
# ─────────────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=cybersecurity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/cybersecurity

# ─────────────────────────────────────────────
# FastAPI Configuration
# ─────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─────────────────────────────────────────────
# Traffic Producer Configuration
# ─────────────────────────────────────────────
# Milliseconds to sleep between rows (200 = ~5 events/sec)
PRODUCER_SLEEP_MS=200

# ─────────────────────────────────────────────
# Dataset Path
# ─────────────────────────────────────────────
DATASET_PATH=data/kdd_cup_99.csv
